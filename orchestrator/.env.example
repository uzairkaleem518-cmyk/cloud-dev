# Shared secret the backend must present on every request. Generate with
# `openssl rand -hex 32`. Must match the token registered for this host
# in the backend's Host registry (see backend/scripts/registerHost.js).
ORCHESTRATOR_TOKEN=change_this_to_a_long_random_string

ORCHESTRATOR_PORT=5001
DOCKER_SOCKET_PATH=/var/run/docker.sock

ALLOWED_IMAGES=cloud-dev-node:latest,cloud-dev-python:latest,cloud-dev-base:latest
WORKSPACE_NETWORK_NAME=cloud-dev-net

# Real kernel isolation for untrusted multi-tenant workloads. Leave blank
# to use Docker's default runc. Requires the runtime to be installed and
# registered on THIS host first - see ../docs/gvisor-kata.md.
#   CONTAINER_RUNTIME=runsc        (gVisor)
#   CONTAINER_RUNTIME=kata-runtime (Kata Containers)
CONTAINER_RUNTIME=
