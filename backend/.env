# Server
PORT=4000
NODE_ENV=development

# Database
MONGO_URI=mongodb://cloud-dev:nQ9xvAK8GbeYpgfQ@ac-w50mmvc-shard-00-00.se4vehl.mongodb.net:27017,ac-w50mmvc-shard-00-01.se4vehl.mongodb.net:27017,ac-w50mmvc-shard-00-02.se4vehl.mongodb.net:27017/?ssl=true&replicaSet=atlas-11kqhq-shard-0&authSource=admin&appName=Cluster0


# Auth
JWT_SECRET=h3ude3njie3dnj2ee3jdidwioecneocdi3rcnwnxenx3rnnwnx3n
JWT_EXPIRES_IN=7d

# Docker / orchestration
# The backend no longer touches docker.sock directly (production
# hardening - see ../orchestrator/). It talks to one or more orchestrator
# daemons instead, registered in the DB via:
#   npm run register:host -- <name> <baseUrl> <token>
# e.g. npm run register:host -- primary http://orchestrator:5001 <ORCHESTRATOR_TOKEN>
# See docs/multi-node.md for adding more than one host.

# Workspace defaults
WORKSPACE_IDLE_TIMEOUT_MINUTES=30
WORKSPACE_CPU_LIMIT=1
WORKSPACE_MEMORY_LIMIT_MB=1024
WORKSPACE_NETWORK_NAME=cloud-dev-net

# Image whitelist (comma separated). Users can only pick from these.
ALLOWED_IMAGES=cloud-dev-node:latest,cloud-dev-python:latest,cloud-dev-base:latest

# SSH (Phase 2 - VS Code Remote-SSH)
# Public hostname or IP of THIS backend's Docker host - workspace SSH ports
# are mapped on this same host, so this is what users' SSH clients connect to.
SSH_HOST=localhost

# Phase 3 - multi-user resource limits
# Cluster-wide caps: total CPU/RAM across ALL live workspaces on this host
# is not allowed to exceed these, regardless of individual user quotas.
# Leave blank/0 to disable the check (not recommended once you have more
# than a couple of users sharing one host).
MAX_CLUSTER_CPU=8
MAX_CLUSTER_MEMORY_MB=16384

# Phase 3 - rate limiting (protects a shared, multi-user instance)
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=120

# Launch-readiness - transactional email (welcome, usage alerts, payment
# failed). Leave SMTP_HOST blank to disable sending - emails are logged
# to the console instead, so registration/workspace creation never fail
# just because mail isn't configured yet.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Forge <no-reply@forge.local>

# Public URL of the frontend, used for links inside emails
APP_URL=http://localhost:5173

# Publicly reachable URL of THIS backend - used to build the OAuth
# callback URL sent to Google/GitHub. Must exactly match what's
# registered in each provider's app settings + /api/auth/<provider>/callback.
BACKEND_URL=http://localhost:4000

# Google/GitHub OAuth ("Continue with Google/GitHub" on the login page).
# Leave blank to disable - the frontend hides the button automatically
# when a provider isn't configured (see GET /api/auth/oauth-config).
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials ->
#   OAuth client ID (Web application). Authorized redirect URI:
#   {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub: github.com/settings/developers -> New OAuth App. Authorization
#   callback URL: {BACKEND_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe billing (routes/billing.js + services/billingService.js). Leave
# STRIPE_SECRET_KEY blank to run without billing - checkout/portal
# routes return a clear "not configured" error instead of crashing.
#
# dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=
# dashboard.stripe.com -> Developers -> Webhooks -> add endpoint
#   {BACKEND_URL}/api/billing/webhook, events: checkout.session.completed,
#   customer.subscription.created/updated/deleted, invoice.payment_failed
# -> reveal the endpoint's signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# dashboard.stripe.com -> Product catalog -> create a Price for each paid
# plan -> paste its price_... ID here. Must match backend/config/plans.js.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
