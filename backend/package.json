{
  "name": "cloud-dev-env-backend",
  "version": "1.0.0",
  "description": "Backend for self-hosted cloud dev environment tool (Codespaces-like)",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
